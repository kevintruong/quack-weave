# name: test/neo4j/sqllogic/credential_registration.test
# description: Register a connection-scoped Neo4j secret and redact its credential fields
# group: [quack_weave]

test-env QW_EXT UNSET_QW_EXT

statement ok
LOAD '{QW_EXT}';

statement ok
CREATE SECRET routes IN connection (
    TYPE quack_weave_neo4j,
    ORIGIN 'https://routes.databases.neo4j.io',
    USERNAME 'qw_dummy_reader',
    PASSWORD 'qw_dummy_password'
);

query TTTIIII
SELECT type, provider, storage,
       contains(secret_string, 'username=redacted'),
       contains(secret_string, 'password=redacted'),
       contains(secret_string, 'qw_dummy_reader'),
       contains(secret_string, 'qw_dummy_password')
FROM duckdb_secrets()
WHERE name = 'routes';
----
quack_weave_neo4j	config	connection	true	true	false	false

statement error
CREATE SECRET missing_origin IN connection (
    TYPE quack_weave_neo4j, USERNAME 'reader', PASSWORD 'dummy'
);
----
QW_CONFIG: Neo4j secret requires a nonempty ORIGIN

statement error
CREATE SECRET empty_username IN connection (
    TYPE quack_weave_neo4j, ORIGIN 'https://routes.databases.neo4j.io', USERNAME '', PASSWORD 'dummy'
);
----
QW_CONFIG: Neo4j secret requires a nonempty USERNAME

statement error
CREATE SECRET null_password IN connection (
    TYPE quack_weave_neo4j, ORIGIN 'https://routes.databases.neo4j.io', USERNAME 'reader', PASSWORD NULL
);
----
QW_CONFIG: Neo4j secret requires a nonempty PASSWORD

statement error
CREATE SECRET colon_username IN connection (
    TYPE quack_weave_neo4j, ORIGIN 'https://routes.databases.neo4j.io', USERNAME 'bad:user', PASSWORD 'dummy'
);
----
QW_CONFIG: Neo4j secret usernames must exclude colons
