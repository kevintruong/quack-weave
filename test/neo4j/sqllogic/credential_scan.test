# name: test/neo4j/sqllogic/credential_scan.test
# description: Resolve Neo4j credentials in the executing connection for every admitted scan
# group: [quack_weave]

test-env QW_EXT UNSET_QW_EXT

test-env QW_NEO4J_FIXTURE_ENDPOINT UNSET_QW_NEO4J_FIXTURE_ENDPOINT

statement ok con1
LOAD '{QW_EXT}';

statement ok con1
SET GLOBAL qw_enable_remote_graphs = true;

# A graph can register and bind before its secret exists.
statement ok con1
SET GLOBAL qw_neo4j_config = '{"alias":"managed","endpoint":"{QW_NEO4J_FIXTURE_ENDPOINT}","database":"neo4j","secret":"routes","timeout_ms":5000,"max_response_bytes":1024,"catalog":{"node:Thing":{"id":"BIGINT"},"relationship:Thing":{"id":"VARCHAR"}}}';

statement ok con1
EXPLAIN SELECT id FROM qw_query('managed', 'cypher', 'RETURN 1 AS id', schema := 'id BIGINT');

statement ok con1
PREPARE route_scan AS SELECT id FROM qw_query('managed', 'cypher', 'RETURN 1 AS id', schema := 'id BIGINT');

statement error con1
SET GLOBAL qw_neo4j_config = '{"alias":"managed","endpoint":"{QW_NEO4J_FIXTURE_ENDPOINT}","database":"neo4j","secret":"routes","credential_ref":"fixture","timeout_ms":5000,"max_response_bytes":1024}';
----
QW_CONFIG

statement error con1
SET GLOBAL qw_neo4j_config = '{"alias":"managed","endpoint":"{QW_NEO4J_FIXTURE_ENDPOINT}","database":"neo4j","timeout_ms":5000,"max_response_bytes":1024}';
----
QW_CONFIG

statement error con1
SET GLOBAL qw_neo4j_config = '{"alias":"managed","endpoint":"{QW_NEO4J_FIXTURE_ENDPOINT}","database":"neo4j","secret":null,"credential_ref":"fixture","timeout_ms":5000,"max_response_bytes":1024}';
----
QW_CONFIG

statement error con1
SET GLOBAL qw_neo4j_config = '{"alias":"managed","endpoint":"{QW_NEO4J_FIXTURE_ENDPOINT}","database":"neo4j","secret":"routes","credential_ref":null,"timeout_ms":5000,"max_response_bytes":1024}';
----
QW_CONFIG

statement error con1
SET GLOBAL qw_neo4j_config = '{"alias":"managed","endpoint":"{QW_NEO4J_FIXTURE_ENDPOINT}","database":"neo4j","secret":"routes","secret":"routes","timeout_ms":5000,"max_response_bytes":1024}';
----
QW_CONFIG

statement error con1
SET GLOBAL qw_neo4j_config = '{"alias":"managed","endpoint":"{QW_NEO4J_FIXTURE_ENDPOINT}","database":"neo4j","secret":"","timeout_ms":5000,"max_response_bytes":1024}';
----
QW_CONFIG

statement error con1
SET GLOBAL qw_neo4j_config = '{"alias":"managed","endpoint":"{QW_NEO4J_FIXTURE_ENDPOINT}","database":"neo4j","secret":"routes","username":"invalid-inline-credential","timeout_ms":5000,"max_response_bytes":1024}';
----
QW_CONFIG

statement error con1
EXECUTE route_scan;
----
QW_AUTH: Remote graph credentials unavailable or rejected

# A valid same-name instance-wide secret cannot satisfy connection storage lookup.
statement ok con1
CREATE SECRET "Routes" IN memory (TYPE quack_weave_neo4j, ORIGIN '{QW_NEO4J_FIXTURE_ENDPOINT}', USERNAME 'managed-user', PASSWORD 'managed-test-password');

statement error con1
EXECUTE route_scan;
----
QW_AUTH: Remote graph credentials unavailable or rejected

# A same-name secret for the wrong extension must not be cast or used.
statement ok con1
CREATE SECRET "Routes" IN connection (TYPE http);

statement error con1
EXECUTE route_scan;
----
QW_AUTH: Remote graph credentials unavailable or rejected

statement ok con1
DROP SECRET "Routes" FROM connection;

statement ok con1
CREATE SECRET "Routes" IN connection (TYPE quack_weave_neo4j, ORIGIN 'https://unrelated.databases.neo4j.io', USERNAME 'managed-user', PASSWORD 'managed-test-password');

statement error con1
EXECUTE route_scan;
----
QW_AUTH: Remote graph credentials unavailable or rejected

statement ok con1
CREATE OR REPLACE SECRET "Routes" IN connection (TYPE quack_weave_neo4j, ORIGIN '{QW_NEO4J_FIXTURE_ENDPOINT}/path', USERNAME 'managed-user', PASSWORD 'managed-test-password');

statement error con1
EXECUTE route_scan;
----
QW_AUTH: Remote graph credentials unavailable or rejected

statement ok con1
CREATE OR REPLACE SECRET "Routes" IN connection (TYPE quack_weave_neo4j, ORIGIN '{QW_NEO4J_FIXTURE_ENDPOINT}', USERNAME 'managed-user', PASSWORD 'managed-test-password');

query I con1
EXECUTE route_scan;
----
11

statement error con1
SELECT * FROM qw_query('managed', 'cypher',
    'CREATE (:WriteMustNotReachFixture) RETURN 1 AS id', schema := 'id BIGINT');
----
QW_ADMISSION

query IT con1
SELECT src, edge FROM GRAPH_TABLE (
  managed MATCH (a:Thing)-[e:Thing]->(b:Thing)
  WHERE b.id = 2 COLUMNS (a.id AS src, e.id AS edge)
) ORDER BY src, edge;
----
10	kept

query I con1
SELECT NOT contains(current_setting('qw_neo4j_config'), 'managed-user')
   AND NOT contains(current_setting('qw_neo4j_config'), 'managed-test-password');
----
true

# A server-side auth failure exposes only the stable local diagnostic.
statement error con1
SELECT * FROM qw_query('managed', 'cypher', 'RETURN 1 AS unauthorized', schema := 'unauthorized BIGINT');
----
<REGEX>:(Invalid Input Error: )?QW_AUTH: Remote graph credentials unavailable or rejected\n

statement error con1
SELECT * FROM qw_query('managed', 'cypher', 'RETURN 1 AS forbidden', schema := 'forbidden BIGINT');
----
<REGEX>:(Invalid Input Error: )?QW_AUTH: Remote graph credentials unavailable or rejected\n

statement error con2
SELECT id FROM qw_query('managed', 'cypher', 'RETURN 1 AS id', schema := 'id BIGINT');
----
QW_AUTH: Remote graph credentials unavailable or rejected

statement ok con2
CREATE SECRET "Routes" IN connection (TYPE quack_weave_neo4j, ORIGIN '{QW_NEO4J_FIXTURE_ENDPOINT}', USERNAME 'peer-user', PASSWORD 'peer-test-password');

query I con2
SELECT id FROM qw_query('managed', 'cypher', 'RETURN 1 AS id', schema := 'id BIGINT');
----
33

statement ok con1
CREATE OR REPLACE SECRET "Routes" IN connection (TYPE quack_weave_neo4j, ORIGIN '{QW_NEO4J_FIXTURE_ENDPOINT}', USERNAME 'managed-user', PASSWORD 'managed-rotated-password');

query I con1
EXECUTE route_scan;
----
22

statement ok con1
DROP SECRET "Routes" FROM connection;

statement error con1
EXECUTE route_scan;
----
QW_AUTH: Remote graph credentials unavailable or rejected

query I con2
SELECT id FROM qw_query('managed', 'cypher', 'RETURN 1 AS id', schema := 'id BIGINT');
----
33

# Closing the default connection discards only its own secret.
statement ok
CREATE SECRET "Routes" IN connection (TYPE quack_weave_neo4j, ORIGIN '{QW_NEO4J_FIXTURE_ENDPOINT}', USERNAME 'managed-user', PASSWORD 'managed-test-password');

query I
SELECT id FROM qw_query('managed', 'cypher', 'RETURN 1 AS id', schema := 'id BIGINT');
----
11

reconnect

statement error
SELECT id FROM qw_query('managed', 'cypher', 'RETURN 1 AS id', schema := 'id BIGINT');
----
QW_AUTH: Remote graph credentials unavailable or rejected

statement ok con1
SET GLOBAL qw_enable_remote_graphs = false;

statement error con2
SELECT id FROM qw_query('managed', 'cypher', 'RETURN 1 AS id', schema := 'id BIGINT');
----
QW_ACCESS

statement ok con1
SET GLOBAL qw_enable_remote_graphs = true;

statement ok con1
SET enable_external_access = false;

statement error con2
SELECT id FROM qw_query('managed', 'cypher', 'RETURN 1 AS id', schema := 'id BIGINT');
----
QW_ACCESS: Remote graph reads require DuckDB external access
