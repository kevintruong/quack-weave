# name: test/ladybug_cloud/sqllogic/cloud_native_attach.test
# description: Query checkpointed native Ladybug graph objects through S3 and GCS
# group: [quack_weave]

test-env QW_EXT UNSET_QW_EXT

test-env QW_LOAD_DUCKDB_HTTPFS UNSET_QW_LOAD_DUCKDB_HTTPFS

# case: ladybug_cloud.s3_attach S3 serves ordered standalone graph rows with endpoint properties and nulls
statement ok
LOAD '{QW_EXT}';

statement ok
{QW_LOAD_DUCKDB_HTTPFS};

statement ok
SET GLOBAL qw_enable_remote_graphs = true;

statement ok
CREATE SECRET s3_reader IN connection
    (TYPE s3, KEY_ID 'qw-s3-fixture', SECRET 'qw-s3-fixture-key', REGION 'us-east-1',
     SESSION_TOKEN 'qw-s3-fixture-token', SCOPE 's3://qw-s3-fixture/snapshots/');

statement ok
SET GLOBAL qw_ladybug_config = '{"alias":"cloud_graph","path":"s3://qw-s3-fixture/snapshots/graph.lbdb","secret":"s3_reader"}';

statement ok
SESSION SET GRAPH cloud_graph;

statement ok
SET SESSION qw_graph_dialect = 'cypher';

query TITI
MATCH (a:Person)-[e:FOLLOWS]->(b:Person)
RETURN a.name AS author, e.id AS edge_id, b.name AS reader, e.weight AS weight ORDER BY edge_id;
----
Alice	10	Bob	7
Alice	11	Bob	NULL
Alice	12	Carol	11
Bob	40	Dina	5

query IT
SELECT edge_id, reader FROM qw_query('cloud_graph', 'cypher',
    'MATCH (a:Person)-[e:FOLLOWS]->(b:Person) WHERE a.id = $author RETURN e.id AS edge_id, b.name AS reader',
    schema := 'edge_id BIGINT, reader VARCHAR', bindings := struct_pack(author := 2::BIGINT));
----
40	Dina

statement ok
PREPARE prior_generation AS SELECT edge_id FROM qw_query('cloud_graph', 'cypher',
    'MATCH (a:Person)-[e:FOLLOWS]->(b:Person) WHERE a.id = 2 RETURN e.id AS edge_id',
    schema := 'edge_id BIGINT');

query I
EXECUTE prior_generation;
----
40

# case: ladybug_cloud.wal_guard Reject nonempty and inaccessible WALs without replacing the current generation
statement error
SET GLOBAL qw_ladybug_config = '{"alias":"cloud_graph","path":"s3://qw-s3-fixture/snapshots/dirty.lbdb","secret":"s3_reader"}';
----
QW_TRANSPORT

statement error
SET GLOBAL qw_ladybug_config = '{"alias":"cloud_graph","path":"s3://qw-s3-fixture/snapshots/denied.lbdb","secret":"s3_reader"}';
----
QW_TRANSPORT

query I
EXECUTE prior_generation;
----
40

# case: ladybug_cloud.gcs_attach GCS serves the exact native graph schema and edge rows through HTTPFS
statement ok
CREATE SECRET gcs_reader IN connection
    (TYPE gcs, KEY_ID 'qw-gcs-fixture', SECRET 'qw-gcs-fixture-key',
     SCOPE 'gs://qw-gcs-fixture/snapshots/');

statement ok
SET GLOBAL qw_ladybug_config = '{"alias":"cloud_graph","path":"gs://qw-gcs-fixture/snapshots/graph.lbdb","secret":"gcs_reader"}';

statement error
EXECUTE prior_generation;
----
QW_CONFIG: Ladybug configuration changed after binding

query TTTT
SELECT typeof(g.author), typeof(g.edge_id), typeof(g.reader), typeof(g.weight)
FROM GRAPH_TABLE (cloud_graph MATCH (a:Person)-[e:FOLLOWS]->(b:Person)
    COLUMNS (a.name AS author, e.id AS edge_id, b.name AS reader, e.weight AS weight)) AS g
ORDER BY g.edge_id LIMIT 1;
----
VARCHAR	BIGINT	VARCHAR	BIGINT

query TITI
SELECT g.author, g.edge_id, g.reader, g.weight
FROM GRAPH_TABLE (cloud_graph MATCH (a:Person)-[e:FOLLOWS]->(b:Person)
    COLUMNS (a.name AS author, e.id AS edge_id, b.name AS reader, e.weight AS weight)) AS g
ORDER BY g.edge_id;
----
Alice	10	Bob	7
Alice	11	Bob	NULL
Alice	12	Carol	11
Bob	40	Dina	5

# case: ladybug_cloud.host_residual The cloud attachment uses host dispatch and preserves the SQL result bag
statement ok
SET SESSION qw_enable_runtime_watchlist = true;

query TT
EXPLAIN (FORMAT JSON) SELECT g.edge_id
FROM GRAPH_TABLE (cloud_graph MATCH (a:Person)-[e:FOLLOWS]->(b:Person)
    COLUMNS (e.id AS edge_id)) AS g
JOIN (VALUES (10::BIGINT), (11::BIGINT)) AS w(edge_id) ON w.edge_id = g.edge_id;
----
physical_plan	<REGEX>:.*Cloud snapshots use host SQL.*

statement ok
CALL enable_logging('QuackWeaveGraphRoute', level = 'info');

query ITTI
SELECT w.sequence, g.author, g.reader, g.weight
FROM GRAPH_TABLE (cloud_graph MATCH (a:Person)-[e:FOLLOWS]->(b:Person)
    COLUMNS (a.name AS author, e.id AS edge_id, b.name AS reader, e.weight AS weight)) AS g
JOIN (VALUES (1, 10::BIGINT), (2, 10::BIGINT), (3, 11::BIGINT),
             (4, NULL::BIGINT), (5, 99::BIGINT), (6, 12::BIGINT)) AS w(sequence, edge_id)
    ON w.edge_id = g.edge_id
ORDER BY w.sequence LIMIT 3;
----
1	Alice	Bob	7
2	Alice	Bob	7
3	Alice	Bob	NULL

query T
SELECT message FROM duckdb_logs() WHERE type = 'QuackWeaveGraphRoute';
----
host

statement ok
CALL disable_logging();

# case: ladybug_cloud.scan_revocation A prepared scan resolves its secret again at runtime
statement ok
PREPARE awaiting_credential AS SELECT edge_id FROM qw_query('cloud_graph', 'cypher',
    'MATCH (a:Person)-[e:FOLLOWS]->(b:Person) WHERE a.id = 2 RETURN e.id AS edge_id',
    schema := 'edge_id BIGINT');

statement ok
DROP SECRET gcs_reader FROM connection;

statement error
EXECUTE awaiting_credential;
----
QW_AUTH: Remote graph credentials unavailable or rejected
