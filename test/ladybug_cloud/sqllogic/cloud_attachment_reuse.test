# name: test/ladybug_cloud/sqllogic/cloud_attachment_reuse.test
# description: Reuse an admitted native Ladybug attachment across graph queries
# group: [quack_weave]

test-env QW_EXT UNSET_QW_EXT

test-env QW_LOAD_DUCKDB_HTTPFS UNSET_QW_LOAD_DUCKDB_HTTPFS

# case: ladybug_cloud.attachment_reuse Execute three queries on one registration and one attachment
statement ok
LOAD '{QW_EXT}';

statement ok
{QW_LOAD_DUCKDB_HTTPFS};

statement ok
SET GLOBAL qw_enable_remote_graphs = true;

statement ok
CREATE SECRET cloud_reader IN connection
    (TYPE s3, KEY_ID 'qw-s3-fixture', SECRET 'qw-s3-fixture-key', REGION 'us-east-1',
     SESSION_TOKEN 'qw-s3-fixture-token', SCOPE 's3://qw-s3-fixture/snapshots/');

statement ok
SET GLOBAL qw_ladybug_config = '{"alias":"cloud_graph","path":"s3://qw-s3-fixture/snapshots/reuse.lbdb","secret":"cloud_reader"}';

query I
SELECT edge_id FROM qw_query('cloud_graph', 'cypher',
    'MATCH (a:Person)-[e:FOLLOWS]->(:Person) WHERE a.id = $author RETURN e.id AS edge_id',
    schema := 'edge_id BIGINT', bindings := struct_pack(author := 2::BIGINT));
----
40

query I
SELECT edge_id FROM GRAPH_TABLE (cloud_graph MATCH (a:Person)-[e:FOLLOWS]->(b:Person)
    WHERE a.id = 1 COLUMNS (e.id AS edge_id)) ORDER BY edge_id;
----
10
11
12

query IT
SELECT edge_id, reader FROM qw_query('cloud_graph', 'cypher',
    'MATCH (a:Person)-[e:FOLLOWS]->(b:Person) WHERE a.id = $author RETURN e.id AS edge_id, b.name AS reader',
    schema := 'edge_id BIGINT, reader VARCHAR', bindings := struct_pack(author := 2::BIGINT));
----
40	Dina
