QW_SCHEMA

# A duplicate alias cannot replace the second provider's active registration.
statement error
SET GLOBAL qw_relate_config = '{"alias":"LADY_ROUTES","path":"{QW_RELATE}"}';
----
QW_CONFIG

statement error
SET GLOBAL qw_relate_config = '{"alias":"broken","path":"{QW_CORRUPT}","catalog":{"airport":{"code":"VARCHAR"}}}';
----
QW_OPEN

statement error
SET GLOBAL qw_relate_config = '{"alias":"bad","path":"{QW_RELATE}","timeout_ms":1000}';
----
QW_CONFIG

statement error
SET GLOBAL qw_relate_config = '{"alias":"bad","path":"{QW_RELATE}","catalog":{"airport":{"code":"UUID"}}}';
----
QW_CONFIG

statement error
SET GLOBAL qw_relate_config = '{"alias":"remote","path":"https://example.invalid/routes.rl"}';
----
QW_ACCESS

statement error
SET GLOBAL qw_relate_config = '{"alias":"dir","path":"{QW_DIR}"}';
