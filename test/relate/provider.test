QW_ACCESS

statement error
SET GLOBAL qw_relate_config = '{"alias":"missing","path":"{QW_MISSING}"}';
----
QW_ACCESS

query I
SELECT count(*) FROM qw_query('relate_routes','cypher',
 $$MATCH (a:airport) WHERE a.code = 'OSL' RETURN a.code AS code$$, schema := 'code VARCHAR');
----
1

# Resetting and replacing a Relate alias does not reset the Ladybug alias.
statement ok
RESET GLOBAL qw_relate_config;

statement error
SESSION SET GRAPH relate_routes;
----
QW_CONFIG

query T
MATCH (o:airport)-[r:route]->(d:airport) WHERE r.rid = 103 RETURN d.code AS destination;
----
LAX

# A RESET racing a SET on an empty provider must allow a later registration.
concurrentforeach action reset set

onlyif action=reset
statement ok
RESET GLOBAL qw_relate_config;

onlyif action=set
statement ok
SET GLOBAL qw_relate_config = '{"alias":"transient","path":"{QW_RELATE}"}';

endloop

statement ok
SET GLOBAL qw_relate_config = '{"alias":"recovered","path":"{QW_RELATE}"}';

query I
SELECT count(*) FROM GRAPH_TABLE (recovered MATCH (a:airport) COLUMNS(a.code AS code)) AS g;
----
4

# Concurrent SETs must leave exactly one owner for the shared alias.
concurrentforeach provider ladybug relate

onlyif provider=ladybug
statement maybe
SET GLOBAL qw_ladybug_config = '{"alias":"race","path":"{QW_LADYBUG}"}';
----
QW_CONFIG: Graph alias must be unique

onlyif provider=relate
statement maybe
SET GLOBAL qw_relate_config = '{"alias":"race","path":"{QW_RELATE}"}';
----
QW_CONFIG: Graph alias must be unique

endloop

statement ok
SESSION SET GRAPH race;

statement ok
SET GLOBAL qw_relate_config = '{"alias":"small","path":"{QW_RELATE}","max_batch_bytes":1}';

statement error
SELECT * FROM qw_query('small','cypher', $$MATCH (a:airport) RETURN a.code AS code$$, schema := 'code VARCHAR');
----
QW_BATCH_BUDGET

statement ok
SET enable_external_access = false;

statement error
SELECT * FROM qw_query('small','cypher', $$MATCH (a:airport) RETURN a.code AS code$$, schema := 'code VARCHAR');
----
QW_ACCESS
