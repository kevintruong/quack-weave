# name: test/relate/watchlist_offer_diagnostics.test
# description: Distinguish an unavailable exact offer from an offer that exceeds the provider cap.
# group: [quack_weave]

test-env QW_EXT UNSET_QW_EXT

test-env QW_RELATE UNSET_QW_RELATE

statement ok
LOAD '{QW_EXT}';

statement ok
SET GLOBAL qw_relate_config = '{"alias":"routes","path":"{QW_RELATE}"}';

statement ok
SET threads = 1;

# Keep the graph on the probe side even though this fixture only has three graph rows.
statement ok
SET disabled_optimizers = 'build_side_probe_side,join_order';

statement ok
CREATE TEMP TABLE watch(k BIGINT);

statement ok
INSERT INTO watch SELECT CASE WHEN i = 0 THEN 201 ELSE i * 1000000000 END FROM range(64) t(i);

statement ok
PREPARE watched AS SELECT k, distance FROM GRAPH_TABLE (
    routes MATCH (a:airport)-[r:route]->(b:airport) COLUMNS(r.rid AS k, r.dist AS distance)
) g JOIN watch USING(k);

statement ok
SET dynamic_or_filter_threshold = 50;

query TT
EXPLAIN (ANALYZE, FORMAT JSON) EXECUTE watched;
----
analyzed_plan	<REGEX>:.*"name": "HASH_JOIN".*"intermediate_rows": 3,[^{}]*"name": "QW_GRAPH_QUERY".*

statement ok
CALL enable_logging(level = 'info');

query II
EXECUTE watched;
----
201	595

query T
SELECT message FROM duckdb_logs() WHERE type = 'QuackWeaveWatchlist';
----
no_exact_keys

statement ok
CALL enable_logging('QuackWeaveWatchlist', level = 'info');

statement ok
CALL truncate_duckdb_logs();

statement ok
SET dynamic_or_filter_threshold = 128;

query II
EXECUTE watched;
----
201	595

query T
SELECT message FROM duckdb_logs() WHERE type = 'QuackWeaveWatchlist';
----
exact_keys

query TT
EXPLAIN (ANALYZE, FORMAT JSON) EXECUTE watched;
----
analyzed_plan	<REGEX>:.*"name": "HASH_JOIN".*"intermediate_rows": 1,[^{}]*"name": "QW_GRAPH_QUERY".*

statement ok
CALL truncate_duckdb_logs();

statement ok
INSERT INTO watch VALUES (64000000000);

query II
EXECUTE watched;
----
201	595

query T
SELECT message FROM duckdb_logs() WHERE type = 'QuackWeaveWatchlist';
----
key_cap

query TT
EXPLAIN (ANALYZE, FORMAT JSON) EXECUTE watched;
----
analyzed_plan	<REGEX>:.*"name": "HASH_JOIN".*"intermediate_rows": 3,[^{}]*"name": "QW_GRAPH_QUERY".*

statement ok
CALL truncate_duckdb_logs();

statement ok
SET SESSION qw_enable_runtime_watchlist = false;

query II
EXECUTE watched;
----
201	595

query I
SELECT count(*) FROM duckdb_logs() WHERE type = 'QuackWeaveWatchlist';
----
0

statement ok
CALL disable_logging();
