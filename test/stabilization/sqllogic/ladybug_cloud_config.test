# name: test/stabilization/sqllogic/ladybug_cloud_config.test
# description: Ladybug cloud graph registration rejects inadmissible paths before opening a graph
# group: [quack_weave]

test-env QW_EXT UNSET_QW_EXT

# case: ladybug_cloud_config.remote_access Cloud registration requires the global remote access switch
statement ok
LOAD '{QW_EXT}';

statement error
SET GLOBAL qw_ladybug_config = '{"alias":"cloud_graph","path":"s3://example-graphs/snapshots/v1.lbdb","secret":"unused_graph_secret"}';
----
QW_ACCESS: Remote graph reads require SET GLOBAL qw_enable_remote_graphs = true

statement ok
SET GLOBAL qw_enable_remote_graphs = true;

# case: ladybug_cloud_config.invalid_requests Reject unqualified providers and unsafe snapshot paths without network I/O
statement error
SET GLOBAL qw_ladybug_config = '{"alias":"cloud_graph","path":"az://graphs/snapshots/v1.lbdb","secret":"unused_graph_secret"}';
----
QW_CONFIG: Unsupported Ladybug cloud storage scheme

statement error
SET GLOBAL qw_ladybug_config = '{"alias":"cloud_graph","path":"s3://example-graphs/snapshots/v1.lbdb?token=placeholder","secret":"unused_graph_secret"}';
----
QW_CONFIG: Invalid Ladybug cloud snapshot URI

statement error
SET GLOBAL qw_ladybug_config = '{"alias":"cloud_graph","path":"gs://example-graphs/snapshots/../v1.lbdb","secret":"unused_graph_secret"}';
----
QW_CONFIG: Invalid Ladybug cloud snapshot URI

statement error
SET GLOBAL qw_ladybug_config = '{"alias":"cloud_graph","path":"gs://example-graphs/snapshots/v1.lbdb"}';
----
QW_CONFIG: A Ladybug cloud graph requires a nonempty secret name

# case: ladybug_cloud_config.xet_policy Admit only secretless, revision-pinned public Hugging Face dataset snapshots
statement ok
SET GLOBAL qw_enable_remote_graphs = false;

statement error
SET GLOBAL qw_ladybug_config = '{"alias":"cloud_graph","path":"xet://datasets/example-owner/example-repo/0123456789abcdef0123456789abcdef01234567/demo.lbdb"}';
----
QW_ACCESS: Remote graph reads require SET GLOBAL qw_enable_remote_graphs = true

statement ok
SET GLOBAL qw_enable_remote_graphs = true;

statement error
SET GLOBAL qw_ladybug_config = '{"alias":"cloud_graph","path":"xet://datasets/example-owner/example-repo/main/demo.lbdb"}';
----
QW_CONFIG: Expected a revision-pinned public Hugging Face Xet snapshot URI

statement error
SET GLOBAL qw_ladybug_config = '{"alias":"cloud_graph","path":"xet://huggingface.co/datasets/example-owner/example-repo/resolve/0123456789abcdef0123456789abcdef01234567/demo.lbdb"}';
----
QW_CONFIG: Expected a revision-pinned public Hugging Face Xet snapshot URI

statement error
SET GLOBAL qw_ladybug_config = '{"alias":"cloud_graph","path":"hf://datasets/example-owner/example-repo/0123456789abcdef0123456789abcdef01234567/demo.lbdb"}';
----
QW_CONFIG: Unsupported Ladybug cloud storage scheme

statement error
SET GLOBAL qw_ladybug_config = '{"alias":"cloud_graph","path":"xet://datasets/example-owner/example-repo/0123456789abcdef0123456789abcdef01234567/demo.lbdb?download=true"}';
----
QW_CONFIG: Expected a revision-pinned public Hugging Face Xet snapshot URI

statement error
SET GLOBAL qw_ladybug_config = '{"alias":"cloud_graph","path":"xet://datasets/example-owner/example-repo/0123456789abcdef0123456789abcdef01234567/demo.lbdb","secret":"unused_graph_secret"}';
----
QW_CONFIG: Public Hugging Face Xet snapshots do not accept a secret

query I
SELECT count(*) FROM qw_graph_providers() WHERE active_alias = 'cloud_graph';
----
0

statement ok
SET enable_external_access = false;

statement error
SET GLOBAL qw_ladybug_config = '{"alias":"cloud_graph","path":"xet://datasets/example-owner/example-repo/0123456789abcdef0123456789abcdef01234567/demo.lbdb"}';
----
QW_ACCESS: Remote graph reads require DuckDB external access
