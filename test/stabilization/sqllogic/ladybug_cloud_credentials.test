# name: test/stabilization/sqllogic/ladybug_cloud_credentials.test
# description: Ladybug cloud attaches require a connection-local credential of the matching type
# group: [quack_weave]

test-env QW_EXT UNSET_QW_EXT

test-env QW_GRAPH UNSET_QW_GRAPH

# case: ladybug_cloud.secret_scope
statement ok
LOAD '{QW_EXT}';

statement ok
SET GLOBAL qw_enable_remote_graphs = true;

statement error
SET GLOBAL qw_ladybug_config = '{"alias":"cloud","path":"s3://qw-fixture/snapshots/graph.lbdb","secret":"no_such_secret"}';
----
QW_AUTH: Remote graph credentials unavailable or rejected

statement ok
CREATE SECRET wrong_type IN connection (TYPE http);

statement error
SET GLOBAL qw_ladybug_config = '{"alias":"cloud","path":"gs://qw-fixture/snapshots/graph.lbdb","secret":"wrong_type"}';
----
QW_AUTH: Remote graph credentials unavailable or rejected

query I
SELECT count(*) FROM qw_graph_providers() WHERE active_alias = 'cloud';
----
0

# case: ladybug_cloud.failed_replacement A failed cloud probe leaves a bound local reader usable
statement ok
SET GLOBAL qw_ladybug_config = '{"alias":"local_graph","path":"{QW_GRAPH}"}';

statement ok
PREPARE still_local AS
SELECT id FROM qw_query('local_graph', 'cypher',
    $$MATCH (a:Document {id: 100})-[:LINKS_TO]->(b:Document) RETURN b.id AS id$$,
    schema := 'id BIGINT');

statement error
SET GLOBAL qw_ladybug_config = '{"alias":"local_graph","path":"s3://qw-fixture/snapshots/new.lbdb","secret":"no_such_secret"}';
----
QW_AUTH: Remote graph credentials unavailable or rejected

query I
EXECUTE still_local;
----
101
101
