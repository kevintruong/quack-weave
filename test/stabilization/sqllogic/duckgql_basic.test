# case: duckgql.basic_bindings Independent path bindings and both endpoint filter positions
# Source: gql_basic_query.test:252
query II rowsort
SELECT * FROM qw_query('duckgql', 'cypher', $$MATCH (a:Person)-[r1:KNOWS]->(b:Person), (a)-[r2:KNOWS]->(b)
RETURN r1.id AS first_id, r2.id AS second_id$$, schema := 'first_id BIGINT, second_id BIGINT');
----
1	1
2	2

# Source: gql_basic_query.test:260
query II rowsort
SELECT * FROM qw_query('duckgql', 'cypher', $$MATCH (a:Person)-[r1:KNOWS]->(b:Person)
MATCH (a)-[r2:KNOWS]->(b)
RETURN r1.id AS first_id, r2.id AS second_id$$, schema := 'first_id BIGINT, second_id BIGINT');
----
1	1
2	2

# Source: gql_basic_query.test:268
query II rowsort
SELECT * FROM qw_query('duckgql', 'cypher', $$MATCH (a:Person)-[r1:KNOWS]->(b:Person)
OPTIONAL MATCH (a)-[r2:KNOWS]->(b)
RETURN r1.id AS first_id, r2.id AS second_id$$, schema := 'first_id BIGINT, second_id BIGINT');
----
1	1
2	2

# Source: gql_basic_query.test:343
query TT
