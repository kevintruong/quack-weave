Grace	NULL

# Source: gql_basic_query.test:294
query TT
SELECT missing.name, target.name
FROM (VALUES (1)) seed(n)
LEFT JOIN qw_query('duckgql', 'cypher', $$MATCH (p:EmptyPerson) RETURN p.name AS name$$, schema := 'name VARCHAR') missing ON true
CROSS JOIN (SELECT name FROM people WHERE age = 42) target;
----
NULL	Ada

