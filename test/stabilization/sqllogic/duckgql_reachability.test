# name: test/stabilization/sqllogic/duckgql_reachability.test
# description: DuckGQL reachability and path bags over a Ladybug cycle
# group: [quack_weave]
# DuckGQL revision b4421c5cb5e3a389f9658de591a0aa6d397da991. See ../duckgql-porting.md for attribution.

test-env QW_EXT UNSET_QW_EXT

test-env QW_DUCKGQL_GRAPH UNSET_QW_DUCKGQL_GRAPH

# case: duckgql.reachability_setup Select the native Ladybug copy of the DuckGQL fixture
statement ok
LOAD '{QW_EXT}';

statement ok
SET GLOBAL qw_ladybug_config = '{"alias":"duckgql","path":"{QW_DUCKGQL_GRAPH}"}';

# case: duckgql.reach_endpoints Endpoint distinctness and variable-length bounds
# Source: gql_reachability_paths.test:38
query I
SELECT count(DISTINCT dst) FROM
qw_query('duckgql', 'cypher', $$MATCH (a:ReachNode)-[:ARC* TRAIL 1..6]->(b:ReachNode)
WHERE a.id = 1 RETURN a.id AS src, b.id AS dst$$, schema := 'src BIGINT, dst BIGINT');
----
4

# Source: gql_reachability_paths.test:43
query I rowsort
SELECT DISTINCT dst FROM
qw_query('duckgql', 'cypher', $$MATCH (a:ReachNode)-[:ARC* TRAIL 1..2]->(b:ReachNode)
WHERE a.id = 1 RETURN a.id AS src, b.id AS dst$$, schema := 'src BIGINT, dst BIGINT');
----
2
3
4

# Source: gql_reachability_paths.test:50
query II
SELECT min(dst), max(dst) FROM
qw_query('duckgql', 'cypher', $$MATCH (a:ReachNode)-[:ARC* TRAIL 1..6]->(b:ReachNode)
WHERE a.id = 1 RETURN a.id AS src, b.id AS dst$$, schema := 'src BIGINT, dst BIGINT');
----
1	4

# Source: gql_reachability_paths.test:56
query I
SELECT count(DISTINCT dst) FROM
qw_query('duckgql', 'cypher', $$MATCH (a:ReachNode)-[:ARC* TRAIL 1..6]->(b:ReachNode)
WHERE a.id = 6 RETURN a.id AS src, b.id AS dst$$, schema := 'src BIGINT, dst BIGINT');
----
1

# Source: gql_reachability_paths.test:61
query II rowsort
SELECT src, count(DISTINCT dst) FROM
qw_query('duckgql', 'cypher', $$MATCH (a:ReachNode)-[:ARC* TRAIL 1..2]->(b:ReachNode)
WHERE a.id <= 2 RETURN a.id AS src, b.id AS dst$$, schema := 'src BIGINT, dst BIGINT') GROUP BY src;
----
1	3
2	2

# Source: gql_reachability_paths.test:69
query I rowsort
SELECT DISTINCT dst FROM
qw_query('duckgql', 'cypher', $$MATCH (a:ReachNode)-[:ARC* TRAIL 2..3]->(b:ReachNode)
WHERE a.id = 1 RETURN a.id AS src, b.id AS dst$$, schema := 'src BIGINT, dst BIGINT');
----
1
3
4

# Source: gql_reachability_paths.test:77
query I rowsort
SELECT DISTINCT dst FROM
qw_query('duckgql', 'cypher', $$MATCH (a:ReachNode)-[:ARC* TRAIL 0..6]->(b:ReachNode)
WHERE a.id = 6 RETURN a.id AS src, b.id AS dst$$, schema := 'src BIGINT, dst BIGINT');
----
5
6

# case: duckgql.reach_bag Count all trails when the result observes multiplicity
# Source: gql_reachability_paths.test:84
query I
SELECT count(*) FROM
qw_query('duckgql', 'cypher', $$MATCH (a:ReachNode)-[:ARC* TRAIL 1..2]->(b:ReachNode)
WHERE a.id = 1 RETURN a.id AS src, b.id AS dst$$, schema := 'src BIGINT, dst BIGINT');
----
6

# Source: gql_reachability_paths.test:89
query I
SELECT count(dst) FROM
qw_query('duckgql', 'cypher', $$MATCH (a:ReachNode)-[:ARC* TRAIL 1..2]->(b:ReachNode)
WHERE a.id = 1 RETURN a.id AS src, b.id AS dst$$, schema := 'src BIGINT, dst BIGINT');
----
6

# case: duckgql.reach_shortest Shortest path lengths across endpoints, bounds and cycles
# Source: gql_shortest_target.test:35
query I
SELECT * FROM
qw_query('duckgql', 'cypher', $$MATCH (a:ReachNode {id: 1}), (b:ReachNode {id: 4})
MATCH p = (a)-[:ARC* SHORTEST 1..6]->(b) RETURN length(p) AS hops$$, schema := 'hops BIGINT');
----
2

# Source: gql_shortest_target.test:44
query I
SELECT * FROM
qw_query('duckgql', 'cypher', $$MATCH p = (a:ReachNode {id: 1})-[:ARC* SHORTEST 1..6]->(b:ReachNode {id: 4})
RETURN length(p) AS hops$$, schema := 'hops BIGINT');
----
2

# Source: gql_shortest_target.test:52
query I
SELECT * FROM
qw_query('duckgql', 'cypher', $$MATCH p = (a:ReachNode {id: 4})<-[:ARC* SHORTEST 1..6]-(b:ReachNode {id: 1})
RETURN length(p) AS hops$$, schema := 'hops BIGINT');
----
2

# Source: gql_shortest_target.test:60
query I
SELECT * FROM
qw_query('duckgql', 'cypher', $$MATCH p = (a:ReachNode {id: 1})-[:ARC* SHORTEST 1..6]->(b:ReachNode {id: 5})
RETURN length(p) AS hops$$, schema := 'hops BIGINT');
----

# Source: gql_shortest_target.test:66
query I
SELECT * FROM
qw_query('duckgql', 'cypher', $$MATCH p = (a:ReachNode {id: 1})-[:ARC* SHORTEST 1..1]->(b:ReachNode {id: 4})
RETURN length(p) AS hops$$, schema := 'hops BIGINT');
----

# Source: gql_shortest_target.test:72
# Select the shortest eligible trail after applying the non-default lower bound.
query I
SELECT min(hops) FROM
qw_query('duckgql', 'cypher', $$MATCH p = (a:ReachNode {id: 1})-[:ARC* TRAIL 3..6]->(b:ReachNode {id: 4})
RETURN length(p) AS hops$$, schema := 'hops BIGINT');
----
3

# Source: gql_shortest_target.test:80
# Select the shortest nonempty trail back to the same vertex.
query I
SELECT min(hops) FROM
qw_query('duckgql', 'cypher', $$MATCH p = (a:ReachNode {id: 1})-[:ARC* TRAIL 1..6]->(a) RETURN length(p) AS hops$$, schema := 'hops BIGINT');
----
3

# Source: gql_shortest_target.test:89
query III rowsort
SELECT * FROM
qw_query('duckgql', 'cypher', $$MATCH p = (a:ReachNode)-[:ARC* SHORTEST 1..6]->(b:ReachNode)
WHERE a.id <= 2 AND b.id >= 3 AND b.id <= 4
RETURN a.id AS src, b.id AS dst, length(p) AS hops$$, schema := 'src BIGINT, dst BIGINT, hops BIGINT');
----
1	3	1
1	4	2
2	3	1
2	4	2

# Source: gql_shortest_target.test:101
query II rowsort
SELECT dst, min(hops) FROM
qw_query('duckgql', 'cypher', $$MATCH p = (a:ReachNode {id: 2})-[:ARC* TRAIL 1..6]->(b:ReachNode)
RETURN b.id AS dst, length(p) AS hops$$, schema := 'dst BIGINT, hops BIGINT') GROUP BY dst;
----
1	3
2	4
3	1
4	2
