# name: test/stabilization/sqllogic/feature_off.test
# description: Cypher-only package reports the unavailable GQL frontend
# group: [quack_weave]

test-env QW_EXT UNSET_QW_EXT

test-env QW_GRAPH UNSET_QW_GRAPH

# case: dialect.off Feature-off package permits original Cypher and rejects explicit GQL
statement ok
LOAD '{QW_EXT}';

statement ok
SET GLOBAL qw_ladybug_config = '{"alias":"kg","path":"{QW_GRAPH}"}';

query I rowsort
SELECT * FROM qw_query('kg', 'cypher', $$MATCH (a:Document {id: 100})-[:LINKS_TO]->(b:Document) RETURN b.id AS id$$, schema := 'id BIGINT');
----
101
101

statement error
EXPLAIN SELECT * FROM qw_query('kg', 'gql', $$MATCH (a:Document)-[:LINKS_TO]->(b:Document) WHERE a.id = 100 RETURN b.id AS id$$, schema := 'id BIGINT');
----
QW_GQL_UNAVAILABLE

# case: provider.inventory_off Cypher-only exposes only the embedded Ladybug descriptor
query TT
SELECT provider_id, setting_name FROM qw_graph_providers();
----
ladybug	qw_ladybug_config
