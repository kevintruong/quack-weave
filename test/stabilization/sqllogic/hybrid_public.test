# name: test/stabilization/sqllogic/hybrid_public.test
# description: Read-only airline routes composed through the public SQL/PGQ syntax
# group: [quack_weave]

require parquet

test-env QW_EXT UNSET_QW_EXT

test-env QW_AIR_ROUTES UNSET_QW_AIR_ROUTES

test-env QW_ROOT UNSET_QW_ROOT

# case: hybrid.catalog Register Ladybug and create the named SQL view
statement ok
LOAD '{QW_EXT}';

statement ok
SET GLOBAL qw_ladybug_config = '{"alias":"air_routes","path":"{QW_AIR_ROUTES}"}';

statement ok
CREATE VIEW atl_routes AS SELECT g.* FROM GRAPH_TABLE (
    air_routes MATCH (o:airport)-[e:route]->(d:airport)
    WHERE o.code = 'ATL'
    COLUMNS (e.rid AS route_id, o.code AS origin, d.code AS destination, e.dist AS miles)
) AS g;

statement ok
COPY (SELECT * FROM (VALUES ('BOS','Boston'),('LAX','Los Angeles'),('SEA','Seattle'),('ORD','Chicago'))
    AS a(code,city)) TO '{QW_ROOT}/airport_directory.parquet' (FORMAT PARQUET);

statement ok
CREATE VIEW airport_directory AS SELECT * FROM read_parquet('{QW_ROOT}/airport_directory.parquet');

# case: hybrid.paging The missing PDX directory entry distinguishes the two limit placements
query TTTI
SELECT r.origin, r.destination, a.city, r.miles
FROM atl_routes AS r JOIN airport_directory AS a ON r.destination = a.code
ORDER BY r.miles DESC NULLS LAST, r.route_id FETCH FIRST 2 ROWS ONLY;
----
ATL	LAX	Los Angeles	1946
ATL	BOS	Boston	946

query TT
WITH top_routes AS (
    SELECT * FROM atl_routes ORDER BY miles DESC NULLS LAST, route_id FETCH FIRST 2 ROWS ONLY
)
SELECT r.origin, r.destination FROM top_routes AS r JOIN airport_directory AS a ON r.destination = a.code;
----
ATL	LAX

# case: hybrid.keys Parallel edges and nullable or missing directory data
query TII
SELECT l.destination, l.route_id, r.route_id FROM atl_routes l JOIN atl_routes r
ON l.destination = r.destination AND l.route_id < r.route_id;
----
BOS	101	102

query TTI
SELECT r.destination, a.city, r.miles FROM atl_routes r LEFT JOIN airport_directory a
ON r.destination = a.code ORDER BY r.route_id;
----
BOS	Boston	946
BOS	Boston	946
LAX	Los Angeles	1946
PDX	NULL	2172
SEA	Seattle	NULL

query I
WITH directory AS (SELECT * FROM airport_directory UNION ALL SELECT 'BOS', 'Extra Boston row')
SELECT COUNT(*) FROM atl_routes r JOIN directory a ON a.code = r.destination;
----
6

# A graph-external literal watchlist retains SQL join multiplicity. One absent
# ID and one NULL cannot match. DuckDB still sees two equal watch rows.
query II
SELECT g.route_id, count(*) FROM GRAPH_TABLE (
  air_routes MATCH (o:airport)-[e:route]->(d:airport) COLUMNS (e.rid AS route_id)
) AS g JOIN (VALUES (101::BIGINT), (104::BIGINT), (101::BIGINT), (NULL::BIGINT), (-1::BIGINT))
  AS watch(id) ON watch.id = g.route_id
GROUP BY g.route_id ORDER BY g.route_id;
----
101	2
104	1

query TT
EXPLAIN (ANALYZE, FORMAT JSON) SELECT g.route_id FROM GRAPH_TABLE (
  air_routes MATCH (o:airport)-[e:route]->(d:airport) COLUMNS (e.rid AS route_id)
) AS g JOIN (VALUES (101::BIGINT), (104::BIGINT), (101::BIGINT), (NULL::BIGINT), (-1::BIGINT))
  AS watch(id) ON watch.id = g.route_id;
----
analyzed_plan	<REGEX>:.*"intermediate_rows": 2,[^{}]*"name": "QW_GRAPH_QUERY_FILTERED".*

query III
SELECT count(*), count(w.id), count(g.miles) FROM GRAPH_TABLE (
  air_routes MATCH (o:airport)-[e:route]->(d:airport) COLUMNS (e.dist AS miles)
) AS g LEFT JOIN (VALUES (946::BIGINT), (NULL::BIGINT)) AS w(id) ON g.miles = w.id;
----
5	2	4

query I
SELECT count(*) FROM GRAPH_TABLE (
  air_routes MATCH (o:airport)-[e:route]->(d:airport) COLUMNS (e.dist AS miles)
) AS g JOIN (VALUES (NULL::BIGINT)) AS w(id) ON g.miles = w.id;
----
0

query I
SELECT g.route_id FROM GRAPH_TABLE (
  air_routes MATCH (o:airport)-[e:route]->(d:airport) COLUMNS (e.rid AS route_id)
) AS g JOIN (VALUES (100+1), (NULL)) AS w(id) ON g.route_id = w.id;
----
101

query I
SELECT count(*) FROM (GRAPH_TABLE (
  air_routes MATCH (o:airport)-[e:route]->(d:airport) COLUMNS (e.rid AS route_id)
) AS g JOIN (VALUES (101::BIGINT)) AS w(id) ON g.route_id = w.id) AS joined;
----
1


# Keep native join association and bind positional parameters in their source order.
query I
SELECT count(*) FROM (VALUES (104::BIGINT)) AS src(id) CROSS JOIN GRAPH_TABLE (air_routes MATCH (o:airport)-[e:route]->(d:airport) COLUMNS (e.rid AS id)) AS g
JOIN (VALUES (101::BIGINT), (104::BIGINT)) AS w(id) ON src.id = w.id;
----
5

query I
SELECT count(*) FROM GRAPH_TABLE (air_routes MATCH (o:airport)-[e:route]->(d:airport) COLUMNS (e.rid AS id)) AS g
JOIN (VALUES (101::BIGINT), (101::BIGINT)) AS w(id) ON g.id = w.id
JOIN (VALUES (101::BIGINT), (104::BIGINT)) AS another(id) ON g.id = another.id;
----
2

statement ok
PREPARE joined_params AS SELECT g.id, g.shift FROM GRAPH_TABLE (
  air_routes MATCH (o:airport)-[e:route]->(d:airport)
  WHERE e.rid > ? COLUMNS (e.rid AS id, CAST(? AS BIGINT) AS shift)
) AS g JOIN (VALUES (CAST(? AS BIGINT))) AS w(id) ON g.id + ? = w.id;

query II
EXECUTE joined_params(100, 77, 114, 10);
----
104	77

query TT
EXPLAIN (ANALYZE, FORMAT JSON) SELECT g.id, g.x FROM GRAPH_TABLE (
  air_routes MATCH (o:airport)-[e:route]->(d:airport) COLUMNS (e.rid AS id, random() AS x)
) AS g JOIN (VALUES (101::BIGINT)) AS w(id) ON g.id = w.id;
----
analyzed_plan	<REGEX>:.*"intermediate_rows": 5,[^{}]*"name": "QW_GRAPH_QUERY".*

# DuckDB uniquifies duplicate derived column names from left to right.
query I
SELECT count(*) FROM GRAPH_TABLE (
  air_routes MATCH (o:airport)-[e:route]->(d:airport)
  COLUMNS (e.rid AS a, e.dist AS a, e.rid AS a_1)
) AS g JOIN (VALUES (946::BIGINT)) AS w(k) ON g.a_1 = w.k;
----
2

query I
SELECT count(*) FROM GRAPH_TABLE (
  air_routes MATCH (o:airport)-[e:route]->(d:airport)
  COLUMNS (e.rid AS z, e.dist AS x, e.rid AS q)
) AS g(a,a,a_1) JOIN (VALUES (946::BIGINT)) AS w(k) ON g.a_1 = w.k;
----
2

# Unary minus outside a cast is resolved using DuckDB's function search path.
statement ok
CREATE TEMP MACRO "-"(x) AS 104;

query I
SELECT g.id FROM GRAPH_TABLE (
  air_routes MATCH (o:airport)-[e:route]->(d:airport) COLUMNS (e.rid AS id)
) AS g JOIN (VALUES (-1::BIGINT)) AS w(id) ON g.id = w.id;
----
104

statement ok
DROP MACRO temp.main."-";

statement ok
CREATE SCHEMA watch_schema;

statement ok
CREATE MACRO watch_schema."-"(x) AS 103;

statement ok
SET search_path=watch_schema;

statement ok
CREATE VIEW stored_watch AS SELECT g.id FROM GRAPH_TABLE (
  air_routes MATCH (o:airport)-[e:route]->(d:airport) COLUMNS (e.rid AS id)
) AS g JOIN (VALUES (-1::BIGINT)) AS w(id) ON g.id = w.id;

statement ok
SET search_path=main;

query I
SELECT id FROM watch_schema.stored_watch;
----
103

# case: hybrid.sets Membership, bags, distinct sets and aggregates over the projected columns
query T
SELECT a.code FROM airport_directory a WHERE EXISTS
    (SELECT 1 FROM atl_routes r WHERE r.destination = a.code)
ORDER BY a.code;
----
BOS
LAX
SEA

query II
SELECT (SELECT COUNT(*) FROM (SELECT destination FROM atl_routes UNION SELECT code FROM airport_directory)),
       (SELECT COUNT(*) FROM (SELECT destination FROM atl_routes UNION ALL SELECT code FROM airport_directory));
----
5	9

query III
SELECT COUNT(*), COUNT(miles), COUNT(DISTINCT destination) FROM atl_routes;
----
5	4	4

# case: hybrid.parameters Host bound values, including a quote, reuse the SQL view
statement ok
PREPARE count_routes AS SELECT COUNT(*) FROM atl_routes WHERE destination = $1;

query I
EXECUTE count_routes('BOS');
----
2

query I
EXECUTE count_routes('ORD');
----
0

query I
EXECUTE count_routes('B''OS');
----
0

# case: hybrid.read_only The native statement uses the same read-only provider as a hybrid view
statement ok
SESSION SET GRAPH air_routes;

statement ok
SET SESSION qw_graph_dialect = 'cypher';

statement error
MATCH (o:airport) WHERE o.code = 'ATL' SET o.code = 'OTHER' RETURN o.code;
----
QW_ADMISSION

query I
SELECT COUNT(*) FROM atl_routes;
----
5

# case: hybrid.explain Bind from the registered metadata and open the file only for execution
statement ok
COPY (SELECT content FROM read_blob('{QW_AIR_ROUTES}')) TO '{QW_ROOT}/hybrid_plan.lbdb' (FORMAT BLOB);

statement ok
SET GLOBAL qw_ladybug_config = '{"alias":"air_routes","path":"{QW_ROOT}/hybrid_plan.lbdb"}';

statement ok
COPY (SELECT 'corrupt storage after graph registration'::BLOB) TO '{QW_ROOT}/hybrid_plan.lbdb' (FORMAT BLOB);

statement ok
EXPLAIN SELECT * FROM atl_routes;

statement error
EXPLAIN ANALYZE SELECT * FROM atl_routes;
----
QW_OPEN
