 "cases": {
  "explain_only": [
   "P12",
   "plan",
   "EXPLAIN (FORMAT JSON) SELECT g.author, count(*) AS n, sum(g.mid % 1000003) AS fingerprint\nFROM GRAPH_TABLE (social MATCH (m:Message)-[r:Message_hasCreator_Person]->(p:Person) COLUMNS (p.PersonId AS author, m.MessageId AS mid)) AS g\nJOIN (VALUES (4398046519825::BIGINT), (2435::BIGINT), (6575::BIGINT), (28587302326226::BIGINT), (-1::BIGINT)) AS watch(author) ON watch.author = g.author\nGROUP BY g.author ORDER BY g.author"
  ],
  "gql_lookup": [
   "P1",
   "point",
   "MATCH (p:Person) WHERE p.PersonId = 4398046519825 RETURN p.PersonId AS id"
  ],
  "literal_watchlist": [
   "P3/P10",
   "groups",
   "SELECT g.author, count(*) AS n, sum(g.mid % 1000003) AS fingerprint\nFROM GRAPH_TABLE (social MATCH (m:Message)-[r:Message_hasCreator_Person]->(p:Person) COLUMNS (p.PersonId AS author, m.MessageId AS mid)) AS g\nJOIN (VALUES (4398046519825::BIGINT), (2435::BIGINT), (6575::BIGINT), (28587302326226::BIGINT), (-1::BIGINT)) AS watch(author) ON watch.author = g.author\nGROUP BY g.author ORDER BY g.author"
  ],
  "table_watchlist": [
   "P3/P10",
   "groups",
   "SELECT g.author, count(*) AS n, sum(mid % 1000003) AS fingerprint FROM GRAPH_TABLE (social MATCH (m:Message)-[r:Message_hasCreator_Person]->(p:Person) COLUMNS (p.PersonId AS author, m.MessageId AS mid)) AS g JOIN watch w ON g.author = w.author GROUP BY g.author ORDER BY g.author"
  ]
 },
 "native_queries": {
  "point": "MATCH (p:Person) WHERE p.PersonId = 4398046519825 RETURN p.PersonId AS id",
  "fanout": "MATCH (m:Message)-[r:Message_hasCreator_Person]->(p:Person) WHERE p.PersonId = 4398046519825 RETURN m.MessageId AS id",
  "top": "MATCH (m:Message)-[r:Message_hasCreator_Person]->(p:Person) WHERE p.PersonId = 4398046519825 RETURN m.MessageId AS id ORDER BY id LIMIT 10",
  "fan_agg": "MATCH (m:Message)-[r:Message_hasCreator_Person]->(p:Person) WHERE p.PersonId = 4398046519825 RETURN count(*) AS n, sum(m.MessageId % 1000003) AS fingerprint",
  "scan": "MATCH (m:Message)-[r:Message_hasCreator_Person]->(p:Person) RETURN count(*) AS n, sum(m.MessageId % 1000003) AS fingerprint",
  "groups": "MATCH (m:Message)-[r:Message_hasCreator_Person]->(p:Person) WHERE p.PersonId IN [4398046519825, 2435, 6575, 28587302326226, -1]\nRETURN p.PersonId AS author, count(*) AS n, sum(m.MessageId % 1000003) AS fingerprint\nORDER BY author",
  "exists": "MATCH (m:Message)-[r:Message_hasCreator_Person]->(p:Person) WHERE p.PersonId IN [4398046519825, 2435, 6575, 28587302326226, -1] RETURN DISTINCT p.PersonId AS author ORDER BY author",
  "self": "MATCH (m:Message)-[r:Message_hasCreator_Person]->(p:Person), (m)-[:Message_hasCreator_Person]->(q:Person) WHERE p.PersonId = 4398046519825 AND q.PersonId = p.PersonId RETURN count(*) AS n, sum(m.MessageId % 1000003) AS fingerprint"
 },
 "setup_sql": {
  "watch": "CREATE TEMP TABLE watch AS SELECT * FROM (VALUES (4398046519825::BIGINT), (2435::BIGINT), (6575::BIGINT), (28587302326226::BIGINT), (-1::BIGINT)) t(author)",
  "author_messages": "CREATE TEMP VIEW author_messages AS SELECT * FROM GRAPH_TABLE (social MATCH (m:Message)-[r:Message_hasCreator_Person]->(p:Person) WHERE p.PersonId = 4398046519825 COLUMNS (p.PersonId AS author, m.MessageId AS mid)) AS g",
  "selected": "CREATE TEMP VIEW selected AS SELECT * FROM GRAPH_TABLE (social MATCH (m:Message)-[r:Message_hasCreator_Person]->(p:Person) WHERE p.PersonId IN (4398046519825, 2435, 6575, 28587302326226, -1) COLUMNS (p.PersonId AS author, m.MessageId AS mid)) AS g",
  "lookup": "PREPARE lookup AS MATCH (p:Person) WHERE p.PersonId = $author RETURN p.PersonId AS id"
 },
