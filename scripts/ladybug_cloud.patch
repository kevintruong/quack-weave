+
+static void validateContentRange(const httplib::Response& response, uint64_t fileOffset,
+    uint64_t bufferLen, uint64_t objectLength) {
+    const auto prefix = std::format("bytes {}-{}/", fileOffset, fileOffset + bufferLen - 1);
+    const auto value = response.get_header_value("Content-Range");
+    if (!value.starts_with(prefix)) {
+        throw IOException("Unexpected HTTP Content-Range");
+    }
+    uint64_t total = 0;
+    const auto end = value.data() + value.size();
+    const auto parsed = std::from_chars(value.data() + prefix.size(), end, total);
+    if (parsed.ec != std::errc{} || parsed.ptr != end || total < fileOffset + bufferLen ||
+        (objectLength != 0 && total != objectLength)) {
+        throw IOException("Unexpected HTTP Content-Range");
+    }
+}
